# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API)

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Server-side only. Never prefix this with NEXT_PUBLIC_.
# Anyone holding this key can read and write every seller's data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build storefront links inside broadcast messages
NEXT_PUBLIC_SITE_URL=http://localhost:3000
